# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/zuriagency?schema=public"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-change-in-production"
NEXTAUTH_URL="https://zuriagency.co.ke"

# M-Pesa Daraja API (Safaricom) - membership STK Push + payouts
MPESA_CONSUMER_KEY="your-consumer-key"
MPESA_CONSUMER_SECRET="your-consumer-secret"
MPESA_PASSKEY="your-passkey"
MPESA_BUSINESS_SHORTCODE="174379"
MPESA_SHORTCODE_TYPE="paybill"  # paybill | till (buy goods)
MPESA_CALLBACK_URL="https://yourdomain.com/api/mpesa/callback"
MPESA_ENVIRONMENT="sandbox"  # sandbox | production
MPESA_MOCK="false"  # true only for local development; never enabled in production

# App
NEXT_PUBLIC_APP_URL="https://zuriagency.co.ke"
NEXT_PUBLIC_APP_NAME="Zuri Agency"
